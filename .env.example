# ============================================================
# AIML Seat Allotment System — Environment Variables (template)
# ============================================================
# Copy this file to backend/.env for local development, OR set
# these as environment variables in your hosting dashboard
# (Render → Environment tab) for production.
# NEVER commit a file containing real values.
# ============================================================

# --- MongoDB ---
# Get this from MongoDB Atlas (cloud) or use local MongoDB.
# Format: mongodb+srv://<user>:<password>@<cluster>/<dbname>
MONGO_URI=YOUR_MONGODB_URI

# --- Google OAuth ---
# Create credentials at: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI:
#   Local dev:  http://localhost:5000/auth/google/callback
#   Production: https://<your-render-app>.onrender.com/auth/google/callback
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
GOOGLE_CALLBACK_URL=http://localhost:5000/auth/google/callback

# --- Session ---
# Use a long random string. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=GENERATE_A_LONG_RANDOM_STRING

# --- Frontend URL ---
# Local dev:  http://localhost:5000
# Production: https://<your-render-app>.onrender.com
FRONTEND_URL=http://localhost:5000

# --- Port ---
# Render injects PORT automatically; locally we default to 5000.
PORT=5000

# --- Node environment ---
# Set to "production" on Render to enable secure cookies + HSTS behavior.
NODE_ENV=development
